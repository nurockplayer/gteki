{
  "name": "gteki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:heavy": "vitest run --mode heavy --maxWorkers=1 --passWithNoTests",
    "test:heavy:box": "node tools/test-box.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @gteki/web dev",
    "build": "pnpm --filter @gteki/web build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
