{
  "name": "gteki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "fonts:subset": "node tools/fonts/subset-sign-font.mjs",
    "map:gen": "node tools/map/gen-symbols.mjs",
    "bake:stairwells": "tsx packages/godot/src/stairwell-bake.ts --station shinjuku",
    "bake:stairwells:check": "tsx packages/godot/src/stairwell-bake.ts --station shinjuku --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:heavy": "vitest run --mode heavy --maxWorkers=1 --passWithNoTests",
    "test:heavy:box": "node tools/test-box.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @gteki/web dev",
    "build": "pnpm --filter @gteki/web build",
    "build:private": "sh tools/private-overlay/run.sh build",
    "deploy:private": "bash scripts/deploy-private.sh",
    "dev:private": "sh tools/private-overlay/run.sh dev"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@types/node": "^24.0.0",
    "fontkit": "2.0.4",
    "jsdom": "^30.1.3",
    "subset-font": "2.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
